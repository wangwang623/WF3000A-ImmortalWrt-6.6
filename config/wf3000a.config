# ══════════════════════════════════════════════════════════════
# WF3000A —— 纯净固件配置（意图清单）
#
# 原则：只把【事后装不了 / 装了会出问题】的编进固件，
#       其余全部留给刷完后 opkg install。
#
# 判断标准：
#   · kmod-*        必须编进去 —— 与内核版本强绑定，事后装必然失败
#   · luci-app-*    可事后装 —— 纯脚本/二进制，opkg install 即可
#   · 中文界面      必须编进去 —— 明确需求，不允许编出英文界面
#   · ca-bundle/ca-certificates 必须编进去 —— 否则 opkg 连不上 https 源，
#                    「按需安装」这个能力本身就不成立
#                    （SSL 后端 libustream-* 由 opkg 依赖自动选中，无需手写）
#
# 依赖不需要手写：make defconfig 会沿依赖树自动展开并全部带进来。
# 例如只写 luci，就会自动补上 uhttpd / rpcd / libuci / libubus / ...
# 想确认最终编了什么，看 workflow 输出的 build.diffconfig，
# 或刷完后在路由器上跑 opkg list-installed。
# ══════════════════════════════════════════════════════════════

# ── ① 目标机型（三级定位，决定编给谁）──────────────────────
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_kst_wf3000a=y
#  ↑ 这个符号不写，filogic 下几十个机型会全编一遍（几小时）
#  ↑ 它存在的前提是 device.mk 已追加到 filogic.mk（由 prepare-source.py 完成）

# ── ② 文件系统 ─────────────────────────────────────────────
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 不写 CONFIG_TARGET_ROOTFS_PARTSIZE：
#   它是给 eMMC/SD 卡 ext4 分区设大小的。本机是 SPI-NAND，rootfs 为
#   UBI volume，大小由 IMAGE_SIZE(115712k) 与 UBINIZE_OPTS 决定，
#   PARTSIZE 在这里根本不生效。原版写的 192 是给 248MiB 布局的残留。

# ── ③ 硬件加速：HNAT 内核驱动 ──────────────────────────────
# 原配置注释：vendor Ethernet patches reference HNAT reset/reason definitions.
# kmod 类，与内核强绑定 —— 必须编进去。
# 没有它千兆转发退回纯软件转发，CPU 占用飙升。
CONFIG_PACKAGE_kmod-mediatek_hnat=y

# 无线固件由 device.mk 的 DEVICE_PACKAGES 按机型自动带出，不在此处写：
#   DEVICE_PACKAGES := kmod-mt7981-firmware mt7981-wo-firmware

# ── ④ 网页管理界面 ─────────────────────────────────────────
# 严格说 luci 也能事后装，但它是「让机器可用」的基础，编进去。
# 会自动带出 uhttpd / rpcd / libuci / libubus 等依赖。
CONFIG_PACKAGE_luci=y
# 不写 luci-ssl：内网管理走 http 即可，避免自签证书警告和多一层依赖。

# ── ⑤ 中文界面（必需）─────────────────────────────────────
# LuCI 的界面语言选项。设为中文后，构建系统会带出对应的 i18n 翻译包。
# 注意它【不是】插件，是 LuCI 自身的语言配置项，因此写成
#   CONFIG_LUCI_LANG_zh_Hans  而不是 CONFIG_PACKAGE_luci-...
CONFIG_LUCI_LANG_zh_Hans=y
# 兜底：显式再勾一个基础翻译包。若上游包名不同会被静默丢弃（不报错），
# 不影响编译，只是这一行白写；上面那行才是主要保证。
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ── ⑥ 支撑「按需安装」的最小闭环 ───────────────────────────
# opkg 是基础组件会自动带进来，显式写出以表明意图。
CONFIG_PACKAGE_opkg=y
# 刷完后要 opkg install，软件源基本都是 https，缺了这三样会报：
#   Failed to send request: Operation not permitted
# 它们不属于「插件」，是让按需安装能跑通的前提。
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
# SSL 后端（libustream-mbedtls / libustream-openssl / ustream-ssl 等）不需要写：
#   opkg 的依赖关系本来就 select 了一个，构建系统会自动挑当前发行版可用的那个。
#   写死具体名字反而可能因上游改名而被静默丢弃（不报错，只是白写一行）。

# ══════════════════════════════════════════════════════════════
# 关于「不编的包」为什么不列在这里
# ────────────────────────────────────────────────────────────
# 本文件是【意图清单】：只写要的，不写不要的。
# 没写的包默认就是 `# CONFIG_xxx is not set`（不编译），
# 列出它们纯属冗余，还会让文件越来越长、越来越难维护。
#
# 原 Anser-y 配置里那种 `# CONFIG_PACKAGE_xxx is not set` 的写法，
# 来自 `./scripts/diffconfig.sh` 输出的【全量快照】——那是给机器读的
# 产物文件，不是给手写的意图清单。两者用途不同，不要混用。
#
# 因此 PassWall / AdGuardHome / Tailscale / Argon / vnStat / nlbwmon /
# WOL / UPnP / zram-swap 等一概不在此出现，需要时刷完后：
#     opkg update && opkg install luci-app-xxx
# ══════════════════════════════════════════════════════════════
