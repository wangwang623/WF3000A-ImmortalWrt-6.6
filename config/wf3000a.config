# WF3000A —— 纯净固件配置
#
# 只保留「能跑起来 + 有网页界面 + 硬件加速」的最小集合。
# 不预装任何应用插件，需要时刷完 SSH 里 opkg install 即可。

# ── 目标机型 ───────────────────────────────────────────────
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_kst_wf3000a=y

# ── 硬件加速（不是插件，是 MT7981 的 HNAT 内核驱动）────────
# 原配置注释：vendor Ethernet patches reference HNAT reset/reason definitions.
# 没有它千兆转发会退回纯软件转发，CPU 占用飙升。必须保留。
CONFIG_PACKAGE_kmod-mediatek_hnat=y

# ── 文件系统 ───────────────────────────────────────────────
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 注意：原配置这里写的是 CONFIG_TARGET_ROOTFS_PARTSIZE=192，那是给 248MiB 布局用的。
# 114MiB 布局下 192MB 远超 UBI 可用空间(约 113MB)，会让 check-size 失败。
# 这里直接不写，交给构建系统按 IMAGE_SIZE 自动决定。

# ── 网页管理界面 + 中文 ────────────────────────────────────
# 这不是「插件」，是让路由器可用的基础组件，保留。
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# ── 以下全部移除（原 Anser-y 配置里的预装插件）────────────
# CONFIG_PACKAGE_luci-app-passwall
# CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray
# CONFIG_PACKAGE_luci-app-ddns-go
# CONFIG_PACKAGE_luci-app-adguardhome
# CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary
# CONFIG_PACKAGE_tailscale
# CONFIG_PACKAGE_luci-theme-argon
# CONFIG_PACKAGE_luci-app-argon-config
# CONFIG_PACKAGE_luci-app-attendedsysupgrade
# CONFIG_PACKAGE_vnstat2
# CONFIG_PACKAGE_luci-app-vnstat2
# CONFIG_PACKAGE_luci-app-nlbwmon
# CONFIG_PACKAGE_luci-app-wol
# CONFIG_PACKAGE_luci-app-upnp
# CONFIG_PACKAGE_opkg
# CONFIG_PACKAGE_luci-app-package-manager
# CONFIG_PACKAGE_luci-ssl
# CONFIG_PACKAGE_ca-bundle
# CONFIG_PACKAGE_ca-certificates
# CONFIG_PACKAGE_zram-swap
#
# 说明：opkg / ca-bundle / ca-certificates 这几个其实会被 luci 或其他依赖
# 自动带进来（依赖自动勾选），所以不写也会出现在最终固件里。
# 想装插件时它们本来就是必需的，不用手动加。
